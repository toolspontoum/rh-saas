{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "pages/api/[[...path]].ts": {
      "maxDuration": 60
    },
    "app/api/**": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/v1/jobs/ai-queue-tick",
      "schedule": "*/5 * * * *"
    }
  ]
}
